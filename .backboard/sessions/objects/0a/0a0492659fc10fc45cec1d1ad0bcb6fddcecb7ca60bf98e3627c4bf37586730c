/* Guest Mobile Header Styles */
@import './shared.css';

/* Mobile Menu Button */
.mobile-menu-btn {
  display: flex;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  flex-direction: column;
  gap: 4px;
  z-index: 1001;
}

.hamburger {
  width: 25px;
  height: 3px;
  background-color: #FFFFFF;
  transition: all 0.3s ease;
  border-radius: 2px;
}

/* Mobile Sidebar */
.mobile-sidebar {
  position: fixed;
  top: 0;
  right: -300px;
  width: 300px;
  height: 100vh;
  background-color: #1C1C1C;
  z-index: 1002;
  transition: right 0.3s ease;
  overflow-y: auto;
  box-shadow: -2px 0 10px rgba(0, 0, 0, 0.3);
}

.mobile-sidebar.open {
  right: 0;
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.sidebar-logo-image {
  height: 40px;
  width: auto;
}

.close-sidebar-btn {
  background: none;
  border: none;
  color: #FFFFFF;
  font-size: 2rem;
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 50%;
  transition: background-color 0.3s ease;
}

.close-sidebar-btn:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

.sidebar-nav {
  padding: 1rem 0;
}

.sidebar-link {
  display: block;
  color: #FFFFFF;
  text-decoration: none;
  padding: 1rem 1.5rem;
  font-size: 1.1rem;
  transition: all 0.3s ease;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.sidebar-link:hover {
  background-color: rgba(255, 255, 255, 0.1);
  color: #F15A29;
  padding-left: 2rem;
}

.sidebar-auth-section {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.sidebar-signup {
  background-color: #F15A29;
  color: white;
  margin: 0 1.5rem;
  border-radius: 8px;
  text-align: center;
  padding: 0.75rem;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
  display: block;
}

.sidebar-signup:hover {
  background-color: #d44a1f;
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(241, 90, 41, 0.3);
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .mobile-menu-btn {
    display: flex;
  }
  
  .header {
    justify-content: space-between;
  }
}

@media (max-width: 480px) {
  .mobile-sidebar {
    width: 280px;
    right: -280px;
  }
  
  .sidebar-link {
    padding: 0.875rem 1.25rem;
    font-size: 1rem;
  }
  
  .sidebar-signup {
    margin: 0 1.25rem;
  }
}
