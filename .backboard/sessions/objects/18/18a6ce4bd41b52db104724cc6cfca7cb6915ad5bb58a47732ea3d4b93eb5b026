/* User Desktop Header Styles */
@import './shared.css';

/* User Navigation Styles */
.user-nav {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.profile-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #FFFFFF;
  text-decoration: none;
  padding: 0.5rem 0.8rem;
  border-radius: 6px;
  transition: all 0.3s ease;
  font-size: 1rem;
  font-weight: 500;
  white-space: nowrap;
}

.profile-link:hover {
  background-color: rgba(255, 255, 255, 0.1);
  color: #F15A29;
}

.user-name {
  color: #FFFFFF;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.logout-btn {
  background-color: #dc2626;
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.logout-btn:hover {
  background-color: #b91c1c;
}


