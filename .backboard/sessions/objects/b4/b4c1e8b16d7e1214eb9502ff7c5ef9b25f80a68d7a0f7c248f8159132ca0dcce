/* Reset Password Page Styles - Consistent with Project Design */
.reset-password-page {
  min-height: calc(100vh - 200px);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 1rem;
  background-color: #f8fafc;
}

.reset-password-card {
  background: white;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  padding: 2.5rem;
  width: 100%;
  max-width: 450px;
  animation: slideUp 0.5s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.reset-password-card h2 {
  text-align: center;
  color: #1C1C1C;
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  letter-spacing: -0.5px;
}

.reset-password-subtitle {
  text-align: center;
  color: #4A4A4A;
  font-size: 1rem;
  margin-bottom: 2rem;
  font-weight: 400;
  line-height: 1.5;
}

.reset-password-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-weight: 600;
  color: #1C1C1C;
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

/* Password Input Styles - Consistent with project */
.password-input-container {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input-container input {
  width: 100%;
  padding: 0.875rem 1rem;
  padding-right: 45px;
  border: 2px solid #e1e5e9;
  border-radius: 8px;
  font-size: 1rem;
  transition: all 0.3s ease;
  background-color: #fafbfc;
}

.password-input-container input:focus {
  outline: none;
  border-color: #F15A29;
  background-color: white;
  box-shadow: 0 0 0 3px rgba(241, 90, 41, 0.1);
}

.password-input-container input::placeholder {
  color: #9ca3af;
  font-weight: 400;
}

.password-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  border-radius: 4px;
  transition: background-color 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-toggle:hover {
  background-color: rgba(0, 0, 0, 0.1);
}

.password-toggle:focus {
  outline: none;
  background-color: rgba(0, 0, 0, 0.1);
}

.password-icon {
  width: 20px;
  height: 20px;
  transition: opacity 0.3s ease;
}

.password-icon.show {
  opacity: 0.7;
}

.password-icon.hide {
  opacity: 1;
  filter: brightness(0.8);
}

.reset-button {
  background-color: #F15A29;
  color: white;
  border: none;
  padding: 0.875rem 1rem;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-top: 0.5rem;
}

.reset-button:hover:not(:disabled) {
  background-color: #d44a1f;
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(241, 90, 41, 0.3);
}

.reset-button:active:not(:disabled) {
  transform: translateY(0);
}

.reset-button:disabled {
  background: #9ca3af;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.reset-password-links {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 2rem;
  text-align: center;
}

.back-to-login, .request-new-reset {
  color: #F15A29;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.9rem;
  transition: color 0.3s ease;
}

.back-to-login:hover, .request-new-reset:hover {
  color: #d44a1f;
  text-decoration: underline;
}

/* Message Styles - Consistent with project */
.error-message, .success-message {
  padding: 0.75rem 1rem;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 500;
  margin-bottom: 1rem;
  text-align: center;
}

.error-message {
  background-color: #fef2f2;
  color: #dc2626;
  border: 1px solid #fecaca;
}

.success-message {
  background-color: #f0fff4;
  color: #059669;
  border: 1px solid #bbf7d0;
}

/* Responsive Design - Consistent with project */
@media (max-width: 768px) {
  .reset-password-page {
    padding: 1rem;
  }
  
  .reset-password-card {
    padding: 2rem;
  }
  
  .reset-password-card h2 {
    font-size: 1.75rem;
  }
  
  .reset-password-form {
    gap: 1.25rem;
  }
  
  .password-input-container input {
    padding: 0.75rem;
    padding-right: 45px;
  }
  
  .reset-button {
    padding: 0.75rem;
    font-size: 0.9rem;
  }
}

@media (max-width: 480px) {
  .reset-password-card {
    padding: 1.5rem;
  }
  
  .reset-password-card h2 {
    font-size: 1.5rem;
  }
  
  .reset-password-subtitle {
    font-size: 0.9rem;
  }
  
  .password-input-container input {
    padding: 0.75rem;
    padding-right: 45px;
    font-size: 0.9rem;
  }
  
  .reset-button {
    padding: 0.75rem;
    font-size: 0.85rem;
  }
  
  .reset-password-links {
    gap: 0.75rem;
  }
  
  .back-to-login, .request-new-reset {
    font-size: 0.85rem;
  }
} 